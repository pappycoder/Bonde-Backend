# =============================================================================
# Bonde Backend - Environment Configuration
# Copy this file to `.env` and fill in real values. All variables are validated
# at boot by a Joi schema (src/config/env.validation.ts) - the app fails fast
# if required values are missing or invalid.
# =============================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed CORS origins. In production this MUST be set
# explicitly; an empty value blocks all cross-origin requests.
CORS_ORIGINS=http://localhost:3000
# Public base URL of the API (used for Swagger host + callbacks).
PUBLIC_URL=http://localhost:3001
# Base URL of the admin console; invitation emails link to <base>/accept-invite.
ADMIN_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable "anon" key - safe to embed in client apps.
SUPABASE_ANON_KEY=
# Service Role key - SERVER ONLY. Never expose to clients. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# HS256 key for short-lived registration/reset tokens (issued by this API).
# Must be at least 32 chars. Generate with: openssl rand -base64 48
AUTH_TOKEN_SECRET=

# --- PostgreSQL (Supabase hosted) ------------------------------------------
# Connection string used by the application at runtime. Use the pooled (port
# 6543, ?pgbouncer=true) connection string for app queries.
DATABASE_URL=
# Direct connection string (port 5432) used for Prisma migrations.
DIRECT_URL=

# --- Redis -----------------------------------------------------------------
# Connection URI for the cache/rate-limit store. Local dev: plain redis://.
# Managed TLS-only providers MUST use rediss:// — e.g. Upstash:
#   REDIS_URL=rediss://:token@your-proj.upstash.io:6379
# The app refuses to boot on a redis:// URL targeting a .upstash.io host.
REDIS_URL=redis://localhost:6379

# --- Push notifications (Firebase Cloud Messaging) --------------------------
# Best-effort push layer. In-app notifications are the source of truth; FCM
# delivery never fails the request. Set these to enable FCM device delivery;
# leave empty for a no-op dispatcher (default).
#
# Provide the Firebase service-account **one** of these two ways (either
# enables push):
#  - FIREBASE_SERVICE_ACCOUNT_JSON  — the service-account JSON as a single
#    inline value. Preferred where there is no persistent filesystem (Vercel
#    serverless functions); also the only shape you can encrypt as a single
#    secret on such hosts.
#  - FIREBASE_SERVICE_ACCOUNT_PATH — path to a service-account JSON file on
#    disk (local dev, hosts that mount secrets: K8s volumes, Render disks).
#
# Inline JSON takes precedence; when both are absent push is a no-op.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Firebase project id (from the Firebase console).
FIREBASE_PROJECT_ID=

# --- Rate Limiting ---------------------------------------------------------
# Global rate-limit window (ms) and max requests per window. Applied via
# @nestjs/throttler, backed by Redis for horizontal scaling.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Optional: block the client for this many ms after exceeding the limit.
# 0 = no block (just reject until window rolls over).
# THROTTLE_BLOCK_DURATION=60000
# Strict limits apply ONLY to handlers marked @StrictThrottle() (e.g. OTP/
# verification endpoints). 5 requests/min with a 5-minute lockout by default.
THROTTLE_STRICT_TTL=60000
THROTTLE_STRICT_LIMIT=5
THROTTLE_STRICT_BLOCK_DURATION=300000
THROTTLE_BLOCK_DURATION=0

# --- Email (Resend) ---------------------------------------------------------
# Used for email OTP delivery during password recovery and verification.
RESEND_API_KEY=
# Verified sender address for transactional emails.
RESEND_FROM_EMAIL=noreply@bonde.app
# Optional public HTTPS PNG logo override. No authentication or expiring URLs.
MAIL_LOGO_URL=
# Optional public HTTPS folder override for *every* email asset. Defaults to
# the existing public Supabase logo bucket. The folder must contain files from
# src/common/mail/templates/assets/index.ts (logo.png, linkedin.png, x.png,
# instagram.png). Takes precedence over MAIL_LOGO_URL.
MAIL_ASSET_BASE_URL=

# --- SMS (Termii) -----------------------------------------------------------
# Used for SMS OTP delivery during phone verification and password recovery.
TERMII_API_KEY=
# Alphanumeric sender ID (max 11 characters).
TERMII_SENDER_ID=Bonde

# --- Encryption --------------------------------------------------------------
# AES-256-GCM key used to encrypt card numbers at rest. Must be 32 bytes,
# hex-encoded (64 hex chars). Generate with: openssl rand -hex 32
CARD_ENCRYPTION_KEY=

# AES-256-GCM key used to encrypt authenticator (TOTP) secrets. Optional: falls
# back to CARD_ENCRYPTION_KEY. Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# --- Payments (Flutterwave v3) ------------------------------------------------
# Base URL for the Flutterwave v3 API.
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
# Secret key (FLWSECK-...). SERVER ONLY. Never expose to clients.
FLUTTERWAVE_SECRET_KEY=
# Hash sent in the `verif-hash` / used to verify the `flutterwave-signature`
# header (HMAC-SHA256 of the raw webhook body). Configured on Flutterwave
# dashboard settings -> webhooks.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Bank code used when provisioning dynamic virtual account numbers.
FLUTTERWAVE_VA_BANK_CODE=090567

# Profile billing: wallet checkout and consented monthly renewals. Disable together during maintenance.
PROFILE_BILLING_ENABLED=true
TERMS_URL=https://www.usebonde.com
PRIVACY_URL=https://www.usebonde.com
SUBSCRIPTION_TERMS_URL=https://www.usebonde.com

# Sudo + Safe Haven live finance. These remain disabled until programme validation.
FINANCE_ENABLED=false
FINANCE_ENVIRONMENT=sandbox
FINANCE_NGN_ENABLED=false
# USD remains disabled in code until two-way executable FX and controls are validated.
FINANCE_USD_ENABLED=false
FINANCE_FEES_VERIFIED=false
FINANCE_TREASURY_VERIFIED=false
SUDO_BASE_URL=https://api.sandbox.sudo.cards
SUDO_API_KEY=
SUDO_BUSINESS_ID=
# Exact Authorization header value configured on both Sudo event and gateway callbacks.
SUDO_WEBHOOK_TOKEN=
SUDO_NGN_FUNDING_SOURCE_ID=
SUDO_NGN_SETTLEMENT_ID=
SUDO_NGN_BRAND=Verve
SUDO_NGN_ISSUE_FEE=0.00
SUDO_USD_FUNDING_SOURCE_ID=
SUDO_USD_SETTLEMENT_ID=
SUDO_USD_BRAND=MasterCard
SUDO_USD_ISSUE_FEE=0.00
SAFE_HAVEN_BASE_URL=https://api.sandbox.safehavenmfb.com
SAFE_HAVEN_CLIENT_ID=
SAFE_HAVEN_ISSUER=
# PEM PKCS8 private key; literal \n sequences are accepted.
SAFE_HAVEN_PRIVATE_KEY=
# Optional exact Authorization callback header, if supported by your programme.
# Transfers are independently fetched and verified even when this is blank.
SAFE_HAVEN_WEBHOOK_TOKEN=
SAFE_HAVEN_BANK_CODE=
SAFE_HAVEN_WITHDRAWAL_FEE=0.00
# Confirm whether reported inward fees are charged to sender or recipient.
SAFE_HAVEN_INCOMING_FEE_BEARER=unknown
FINANCE_TREASURY_ACCOUNT_NUMBER=
# Use a separate high-entropy secret for the scheduled job endpoint.
FINANCE_JOB_TOKEN=
# Used by scripts/finance-worker.mjs, not by the Nest configuration.
FINANCE_API_URL=
