# Bonde Backend: copy to .env and fill in credentials. Never commit .env.
# Optional overrides and production controls: docs/environment-advanced.md

# Core application
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
REDIS_URL=redis://localhost:6379
# Generate: openssl rand -base64 48 (at least 32 characters)
AUTH_TOKEN_SECRET=
# Generate: openssl rand -hex 32 (64 hex characters)
CARD_ENCRYPTION_KEY=

# Email and SMS: required for verification flows
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@bonde.app
TERMII_API_KEY=

# AI: add your key and enable when ready. Model defaults to gpt-6-luna.
AI_SHOPPING_ENABLED=false
# Enable after deploying the AI monitoring migration.
AI_USAGE_MONITORING_ENABLED=false
OPENAI_API_KEY=
# Live product search: both a key and official merchant hostnames are needed.
BRAVE_SEARCH_API_KEY=
# Validated Nigerian merchants; hostnames only (no URLs or wildcards).
SHOPPING_MERCHANT_HOSTS=jumia.com.ng,konga.com,slot.ng,pointekonline.com,kara.com.ng

# Data/TV: reuse Safe Haven credentials. Sandbox only for initial testing.
SERVICE_PURCHASES_ENABLED=false
FINANCE_ENVIRONMENT=sandbox
SAFE_HAVEN_CLIENT_ID=
SAFE_HAVEN_ISSUER=
# PEM PKCS8 private key; literal \n sequences are accepted.
SAFE_HAVEN_PRIVATE_KEY=
# Needed for purchase submission, not for reading plans or preparing quotes.
FINANCE_TREASURY_ACCOUNT_NUMBER=
# Sudo/banking stays disabled until separately configured and validated.
FINANCE_ENABLED=false

# Optional approved NGN programmes; see docs/sudo-safehaven.md.
SUDO_NGN_CARD_PROGRAMMES=

# Backend origin for all scheduled jobs; HTTPS except for local loopback.
FINANCE_API_URL=https://api.usebonde.com

# Card/payment prerequisites; leave gates false until provider configuration is verified.
FINANCE_NGN_ENABLED=false
FINANCE_FEES_VERIFIED=false
FINANCE_TREASURY_VERIFIED=false
SUDO_API_KEY=
SUDO_BUSINESS_ID=
SUDO_WEBHOOK_TOKEN=
SUDO_NGN_FUNDING_SOURCE_ID=
SUDO_NGN_SETTLEMENT_ID=
SAFE_HAVEN_BANK_CODE=
SAFE_HAVEN_INCOMING_FEE_BEARER=unknown
FINANCE_JOB_TOKEN=
# Public callback origin; localhost cannot receive provider callbacks.
PUBLIC_URL=https://api.usebonde.com
# Set true only after production AI cost review.
AI_PRICING_APPROVED=false
